{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sakhalin/action",
  "title": "Sakhalin Kids Action",
  "description": "Declarative timeline made of named pose phases.",
  "type": "object",
  "required": ["version", "id", "phases"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "id": { "$ref": "#/$defs/identifier" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/phase" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "phase": {
      "type": "object",
      "required": ["name", "duration_ms", "pose"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "pose": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    }
  }
}
