{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sakhalin/rig_profile",
  "title": "Sakhalin Kids RigProfile",
  "description": "Reusable structural rig contract for character animation. Not a production-run artifact.",
  "type": "object",
  "required": ["version", "id", "parts", "capabilities"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "parts": {
      "$ref": "#/$defs/parts"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "parts": {
      "type": "object",
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "blink",
        "gaze",
        "mouth_visemes",
        "head_turn",
        "arm_gestures",
        "tail_motion",
        "flipper_gestures",
        "wing_gestures"
      ],
      "properties": {
        "blink": { "type": "boolean" },
        "gaze": { "type": "boolean" },
        "mouth_visemes": { "type": "boolean" },
        "head_turn": { "type": "boolean" },
        "arm_gestures": { "type": "boolean" },
        "tail_motion": { "type": "boolean" },
        "flipper_gestures": { "type": "boolean" },
        "wing_gestures": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
